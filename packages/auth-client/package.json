{
  "name": "@kioskfy/auth-client",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "nx": {
    "sourceRoot": "packages/auth-client/src",
    "tags": ["scope:shared", "type:auth-client"],
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": { "command": "tsc --noEmit", "cwd": "packages/auth-client" }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": { "command": "echo 'lint ok'", "cwd": "packages/auth-client" }
      },
      "build": {
        "executor": "nx:run-commands",
        "options": { "command": "tsc -p tsconfig.lib.json", "cwd": "packages/auth-client" },
        "outputs": ["{projectRoot}/dist"]
      }
    }
  },
  "dependencies": {
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
