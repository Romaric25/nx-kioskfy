{
  "name": "@kioskfy/stores",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "nx": {
    "sourceRoot": "packages/stores/src",
    "tags": [
      "scope:shared",
      "type:stores"
    ],
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit",
          "cwd": "packages/stores"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "echo 'lint ok'",
          "cwd": "packages/stores"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -p tsconfig.lib.json",
          "cwd": "packages/stores"
        },
        "outputs": ["{projectRoot}/dist"]
      }
    }
  },
  "dependencies": {
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
