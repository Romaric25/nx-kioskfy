{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "paths": {
      "@kioskfy/types": ["../types/src/index.ts"],
      "@kioskfy/types/accounting": ["../types/src/accounting.types.ts"]
    }
  },
  "include": ["src"]
}
