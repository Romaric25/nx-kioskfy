{
  "name": "@kioskfy/types",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain.types.ts",
    "./payment": "./src/payment.types.ts",
    "./accounting": "./src/accounting.types.ts"
  },
  "nx": {
    "sourceRoot": "packages/types/src",
    "tags": [
      "scope:shared",
      "type:types"
    ],
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit",
          "cwd": "packages/types"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "echo 'lint ok'",
          "cwd": "packages/types"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -p tsconfig.lib.json",
          "cwd": "packages/types"
        },
        "outputs": ["{projectRoot}/dist"]
      }
    }
  }
}
