{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": false,
    "types": ["vite/client"],
    "paths": {
      "@kioskfy/types": ["../../packages/types/src/index.ts"],
      "@kioskfy/types/accounting": ["../../packages/types/src/accounting.types.ts"],
      "@kioskfy/api-client": ["../../packages/api-client/src/index.ts"],
      "@kioskfy/stores": ["../../packages/stores/src/index.ts"],
      "@kioskfy/hooks": ["../../packages/hooks/src/index.ts"],
      "@kioskfy/hooks/client": ["../../packages/hooks/src/client.ts"],
      "@kioskfy/hooks/auth-client": ["../../packages/hooks/src/auth-client.ts"],
      "@kioskfy/auth-client": ["../../packages/auth-client/src/index.ts"],
      "@kioskfy/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
