# ──────────────────────────────────────────────────────────────
# kioskfy API — environment configuration (example)
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env`.
# ──────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

DATABASE_URL=mysql://user:password@localhost:3306/kioskfy

# Configuration CORS
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Mail
SMTP_HOST=smtp.example.com
SMTP_USER=mail@example.com
SMTP_PASSWORD=change-me
SMTP_PORT=587

# REDIS
REDIS_HOST=localhost
REDIS_USER=
REDIS_PASSWORD=
REDIS_PORT=6379

# RABBITMQ
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_MAIL_QUEUE=mail
RABBITMQ_ORGANIZATIONS_QUEUE=organizations

# R2 CLOUDFLARE
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.example.com
R2_BUCKET_NAME=kioskfy

# BETTER AUTH
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000/api/auth
APP_URL=http://localhost:3003

# MONEROO
MONEROO_HOST=https://api.moneroo.io
MONEROO_SECRET_KEY=change-me
MONEROO_WEBHOOK_SECRET=change-me
EXCHANGE_API_URL=https://api.example.com
EXCHANGE_APP_ID=change-me

MEDIA_URL=https://media.example.com
LABO_URL=http://localhost:3002
ADMIN_URL=http://localhost:3001
CRON_SECRET=change-me

# GOOGLE OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# FACEBOOK OAuth
FACEBOOK_CLIENT_ID=change-me
FACEBOOK_CLIENT_SECRET=change-me

RESEND_API_KEY=change-me
